whatsmeow attaches <biz><buttons_response/></biz> (or list_response) to a
reply to a business button or list message. Real clients never send it,
and the server rejects the stanza with error 479, so tapping a bot's
button fails. This is tulir/whatsmeow#1221; drop the patch once that PR
is merged upstream. Applied to the vendored module by .nix/package.nix
and build-aux/flatpak/com.sezdm.chatot.yml.

--- a/send.go
+++ b/send.go
@@ -1018,12 +1018,8 @@
 		return getButtonTypeFromMessage(msg.EphemeralMessage.Message)
 	case msg.ButtonsMessage != nil:
 		return "buttons"
-	case msg.ButtonsResponseMessage != nil:
-		return "buttons_response"
 	case msg.ListMessage != nil:
 		return "list"
-	case msg.ListResponseMessage != nil:
-		return "list_response"
 	case msg.InteractiveResponseMessage != nil:
 		return "interactive_response"
 	default:
